{
  "name": "bulk-csv-ingestion-service",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 foundation for the bulk CSV ingestion take-home",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bootstrap:staff": "node dist/scripts/create-staff.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.4",
    "argon2": "0.45.1",
    "csv-parse": "7.0.3",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "jiti": "2.7.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
