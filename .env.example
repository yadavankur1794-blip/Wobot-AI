NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# These are disposable local Compose credentials. Compose requires these
# values through .env or the shell; do not reuse them outside local review.
# Keep catalog/catalog when reusing the existing disposable volume.
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
DATABASE_POOL_MAX=5
LOG_LEVEL=info
UPLOAD_ROOT=/data/uploads
REPORT_ROOT=/data/reports
# Staff bootstrap is intentionally disabled unless all of these are supplied
# to the one-shot `npm run bootstrap:staff` command.
STAFF_BOOTSTRAP_ENABLED=false
STAFF_BOOTSTRAP_SECRET=
STAFF_BOOTSTRAP_CONFIRM=
STAFF_EMAIL=
STAFF_PASSWORD=
